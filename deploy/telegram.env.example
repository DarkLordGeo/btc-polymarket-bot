# Copy this to /etc/btc-bot/telegram.env on the VM (NOT into the git repo),
# then: sudo chmod 600 /etc/btc-bot/telegram.env && sudo chown btcbot:btcbot /etc/btc-bot/telegram.env
#
# Referenced by both systemd units (EnvironmentFile=) and read directly by
# telegram_alert.sh — one file, one source of truth for these two secrets.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
