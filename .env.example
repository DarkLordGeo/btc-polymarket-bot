# Copy this file to .env and fill in what you use.

# Optional: only needed if you turn on the Claude "supervisor" layer
# (periodic higher-level commentary on the bot's recent decisions).
ANTHROPIC_API_KEY=

# Paper trading starting balance, in USD.
STARTING_BANKROLL=1000

# Never put a real wallet private key in this project while LIVE_TRADING_ENABLED
# is anything other than "false". See README.md before ever changing that.
LIVE_TRADING_ENABLED=false
POLYGON_PRIVATE_KEY=

# Optional: Telegram alerting (status/trade/error notifications sent from
# inside the running bot). Leave both blank to disable — everything in
# alerting/telegram_notify.py becomes a silent no-op. Get the token from
# @BotFather; get the chat id by messaging your bot once, then checking
# https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# How often (seconds) to send a periodic status summary. Default 4h.
TELEGRAM_STATUS_INTERVAL_SEC=14400
# Minimum seconds between two alerts of the same kind (anti-spam). Default 15m.
TELEGRAM_ERROR_COOLDOWN_SEC=900
